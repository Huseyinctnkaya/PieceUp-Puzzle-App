// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model PuzzleConfig {
  id                  String    @id @default(cuid())
  shopDomain          String
  name                String    @default("Puzzle")
  // Storefront copy, shown above the puzzle card. Nullable because the popup
  // reads fine without any of it — an empty headline simply renders nothing.
  badgeLabel          String?
  headline            String?
  description         String?
  imageUrl            String?
  pieceCount          Int       @default(9)

  // Gameplay, named to match the props the storefront puzzle takes.
  knobSize            Int       @default(24)
  difficulty          String    @default("easy")
  trayPosition        String    @default("right")
  accentColor         String    @default("#1a1a1a")
  // Null means no limit rather than "no time": zero seconds would be a puzzle
  // nobody can finish.
  timeLimitSeconds    Int?
  // Zero means unlimited, which is how the puzzle already reads it.
  shuffleLimit        Int       @default(0)
  giftStep            Boolean   @default(false)
  giftBoxMode         Boolean   @default(false)

  // Not editable: the merchant's settings are the ones the reference exposes,
  // and these keep the puzzle's own defaults. Kept as columns rather than
  // dropped so they are here if they are ever worth exposing.
  showGuide           Boolean   @default(true)
  wrongPieceBehaviour String    @default("return")
  showMoves           Boolean   @default(true)
  rememberProgress    Boolean   @default(true)
  confetti            Boolean   @default(true)
  rewardType          String    @default("PERCENTAGE_DISCOUNT")
  rewardValue         String    @default("10")
  triggerMode         String    @default("BUTTON")
  triggerPage         String    @default("ALL")
  triggerDelaySeconds Int?
  playLimitType       String    @default("ONCE_EVER")
  isActive            Boolean   @default(false)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  gifts               PuzzleGift[]

  @@index([shopDomain])
}

/// One of the gifts a shopper picks between once the puzzle is solved.
model PuzzleGift {
  id             String       @id @default(cuid())
  puzzleConfigId String
  puzzleConfig   PuzzleConfig @relation(fields: [puzzleConfigId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  badgeLabel     String?
  imageUrl       String?

  /// What this gift is actually worth. NONE mints no code at all — the
  /// "try again" prize — which is why the type is not implied by the value.
  discountType   String   @default("PERCENTAGE_OFF_ORDER")
  /// Percentage (1-100) or a money amount, by type. Unused for the others.
  discountValue  String   @default("10")
  /// Shopify gids the discount is limited to, as JSON. Empty means the whole
  /// order. Stored as JSON rather than its own table: it is a list the admin
  /// writes and the reward service reads back whole, never queried across.
  productIds     String   @default("[]")
  collectionIds  String   @default("[]")
  /// Display order, so the merchant's arrangement survives a reload.
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([puzzleConfigId])
}

// Daily funnel counters, one row per shop/puzzle/day.
//
// Deliberately aggregated rather than one row per event: a busy shop would
// otherwise write a row on every popup open, and the only thing the stats page
// asks of this data is "how many per day", which counters answer directly and
// with bounded growth.
//
// The three stages are distinct on purpose. `completed` minus `rewarded` is
// the number of shoppers who finished the puzzle but got nothing — which
// happens when the shop's plan ran out of monthly rewards, and is exactly the
// thing a merchant needs to see.
model PuzzleStat {
  id         String @id @default(cuid())
  shopDomain String
  puzzleId   String
  date       String // YYYY-MM-DD, matching PlayRecord.playDate
  opened     Int    @default(0)
  completed  Int    @default(0)
  rewarded   Int    @default(0)

  @@unique([shopDomain, puzzleId, date])
  @@index([shopDomain, date])
}

// Per-shop onboarding state. The setup guide's first two steps are derived
// from real data (does a puzzle exist / is one active), but "did the merchant
// turn on the theme app embed" can't be read back from the Admin API without
// a themes scope and a settings_data.json fetch, so the merchant marks it
// themselves and we remember it here.
model ShopSetup {
  shopDomain      String   @id
  themeEmbedDone  Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model PlayRecord {
  id           String   @id @default(cuid())
  shopDomain   String
  identityKey  String
  playDate     String
  completed    Boolean  @default(false)
  discountCode String?
  playedAt     DateTime @default(now())

  @@unique([shopDomain, identityKey, playDate])
}
