{% comment %}PieceUp puzzle popup embed{% endcomment %}
{% comment %}
  No stylesheet links here: the widget renders inside a shadow root and loads
  its own styles in there, where the theme's CSS cannot reach them. It finds
  them beside its own script, so this block never has to name them.
{% endcomment %}
<div
  id="pieceup-root"
  data-customer-id="{{ customer.id }}"
  data-trigger-page="{% if template.name == 'product' %}PRODUCT{% elsif template.name == 'cart' %}CART{% else %}ALL{% endif %}"
></div>
<script type="module">
  import { initPieceUp } from "{{ 'widget.js' | asset_url }}";
  document.addEventListener("DOMContentLoaded", () => {
    initPieceUp(document.getElementById("pieceup-root"));
  });
</script>

{% schema %}
{
  "name": "PieceUp Puzzle",
  "target": "body",
  "settings": []
}
{% endschema %}
