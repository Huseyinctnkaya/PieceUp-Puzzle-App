/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Local dev app configuration. shopify.app.toml is the production app and is
# tracked; any named config points at a personal development app with its own
# client_id and its own tunnel URLs, which is environment-specific in the same
# way .env is. Keeping it out also means `config use dev` followed by a stray
# `app deploy` can only ever touch a machine's own dev app.
/shopify.app.*.toml
!/shopify.app.toml

# Hide files auto-generated by react router
.react-router/

# Playwright run artifacts
/test-results/
/playwright-report/
/blob-report/