{
  "include": ["env.d.ts", "**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
  // The reference puzzle under extensions/pieceup-widget/src is Preact and is
  // compiled by its own esbuild step, which aliases the two @ikas modules it
  // imports. Type-checking it here would resolve neither those aliases nor its
  // JSX, since this project's tsx is React. Files it imports that the app also
  // imports — lib/puzzle.ts — are still checked, because exclude only trims the
  // root file set, never what an included file pulls in.
  "exclude": [
    "node_modules",
    "extensions/pieceup-widget/src/components/**",
    "extensions/pieceup-widget/src/sub-components/**",
    "extensions/pieceup-widget/src/shims/**",
    "extensions/pieceup-widget/src/entry.tsx"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "removeComments": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "types": ["@react-router/node", "vite/client", "@shopify/polaris-types"],
    "rootDirs": [".", "./.react-router/types"]
  }
}
